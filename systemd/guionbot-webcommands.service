[Unit]
Description=GuionBot Web Commands Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/GuionBot/guionbot-master
EnvironmentFile=/home/pi/GuionBot/web_commands.env
ExecStart=/usr/bin/python3 /home/pi/GuionBot/guionbot-master/web_commands_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
